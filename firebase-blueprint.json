{
  "entities": {
    "users": {
      "title": "User Profile",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["email"]
    },
    "user_data": {
      "title": "Teacher Isolated Workspace",
      "description": "Per-user private application data including classes, students, grades, attendance, logs, and biometric devices",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "classes": { "type": "array" },
        "students": { "type": "array" },
        "dailyLogs": { "type": "array" },
        "gradeRecords": { "type": "object" },
        "assessments": { "type": "array" },
        "measurementItems": { "type": "array" },
        "measurementValues": { "type": "object" },
        "attendanceCheckItems": { "type": "array" },
        "incentiveRecords": { "type": "array" },
        "timetable": { "type": "array" },
        "settings": { "type": "object" },
        "fingerprintDevices": { "type": "array" },
        "updatedAt": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/user_data/{userId}": {
      "schema": "user_data",
      "description": "Private isolated teacher workspace document strictly accessed only by the owning teacher"
    },
    "/users/{userId}": {
      "schema": "users",
      "description": "Private user account profile document"
    }
  }
}

